# Admin dashboard environment variables
# Copy these values into: Vercel -> <admin project> -> Settings -> Environment Variables
# Apply to Production (and Preview if you use preview deployments), then redeploy.

# REQUIRED: server-side origin of the deployed storefront.
# Example: https://vardayini-store.vercel.app
STORE_API_URL=https://your-store.vercel.app

# REQUIRED: browser-side origin used by preview links/iframes.
# Next.js inlines NEXT_PUBLIC_* at BUILD time, so redeploy after changing it.
NEXT_PUBLIC_STORE_API=https://your-store.vercel.app

# REQUIRED: must be identical to the storefront project's ADMIN_API_KEY.
ADMIN_API_KEY=change-me-to-a-long-random-value
STORE_ADMIN_KEY=change-me-to-a-long-random-value
