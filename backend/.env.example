# ==============================================================================
# Vardayini Sweet Mart — Python FastAPI Backend Configuration
# ==============================================================================

# MongoDB Connection (Local Compass Instance)
MONGODB_URI=mongodb://127.0.0.1:27017/
DATABASE_NAME=vardayini_sweets

# Server Network Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS: Comma-separated list of allowed origins (e.g. Vercel, localhost, ngrok)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.vercel.app,https://*.ngrok-free.app,https://*.ngrok.io,*

# Admin API Protection (pass via 'x-admin-key' or 'Authorization: Bearer <token>' header)
ADMIN_SECRET_KEY=vardayini_admin_secret_1986

# Authentication & JWT Configuration
JWT_SECRET_KEY=vardayini_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute
