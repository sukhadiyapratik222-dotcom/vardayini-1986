# Storefront environment variables
# Copy these values into: Vercel -> <storefront project> -> Settings -> Environment Variables
# Apply to Production (and Preview if you use preview deployments), then redeploy.

# REQUIRED: signs the vs_session cookie. Use a long random value and keep it
# identical across deployments so sessions survive redeploys.
SESSION_SECRET=change-me-to-a-long-random-value

# REQUIRED: must be identical to the admin dashboard's ADMIN_API_KEY.
ADMIN_API_KEY=change-me-to-a-long-random-value
STORE_ADMIN_KEY=change-me-to-a-long-random-value

# REQUIRED for persistence on Vercel: Vercel's filesystem is read-only and
# each serverless instance gets its own in-memory SQLite database. Without a
# remote MongoDB, data (products, orders, users) resets between cold starts.
# Use a free MongoDB Atlas cluster. Do NOT use 127.0.0.1 / localhost here.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vardayini_sweets

# Optional: cloud MySQL (also used as a login fallback).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=vardayini_sweets

# Optional: SMS OTP delivery. Leave unset to simulate OTPs in logs.
FAST2SMS_API_KEY=

# Optional: password for the seeded admin@vardayini.com account.
# If unset, the built-in default admin123 is used.
ADMIN_SEED_PASSWORD=
